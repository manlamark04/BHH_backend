# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bhh
DB_USER=root
DB_PASSWORD=your_mysql_password

# Authentication & Security
# WARNING: In production, JWT_SECRET must be at least 32 characters long
JWT_SECRET=your_super_secret_jwt_key_change_this_min_32_chars
JWT_EXPIRES_IN=7d

# Server & Client Environment
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
UPLOADS_DIR=uploads

# Business Policies
MIN_DEPOSIT_PERCENT=100
PENDING_PAYMENT_TIMEOUT_HOURS=24
NO_SHOW_FEE_POLICY=percentage
NO_SHOW_FEE_PERCENTAGE=20
NO_SHOW_FEE_FLAT_AMOUNT=200
